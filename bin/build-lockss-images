#!/bin/sh

# build all projects and docker images.  with -p, pushes images to dockerhub


case "$1" in
  -p | --push )
    shift
    (cd lockss-parent-pom ; mvn install ) && \
    mvn -T 1.0C clean deploy -P doSnapshot -DskipTests=true -DskipArtifactUpload=true -DskipGpg=true -DskipJavadoc=true "$@"
    break;;
  * )
    (cd lockss-parent-pom ; mvn install ) && \
    mvn -T 1.0C -DskipDockerBuild=false -DskipTests clean install "$@"
esac
